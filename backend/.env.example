PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/community_chat?retryWrites=true&w=majority
MONGODB_DB=community_chat
MONGODB_DNS_SERVERS=
# Comma-separated production origins; localhost origins are allowed only in development.
CORS_ALLOWED_ORIGINS=
JWT_ACCESS_SECRET=replace_with_64_byte_hex
JWT_REFRESH_SECRET=replace_with_64_byte_hex
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CHAT_VISIBLE_DAYS=7
DB_PURGE_DAYS=10.5
MAX_IMAGE_BYTES=5242880
TRUST_PROXY=0
